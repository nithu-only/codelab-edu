# Root env — consumed by docker-compose.yml (env_file + build args)
# Copy to .env and adjust before `docker compose up --build`

# Backend
SERVER_PORT=8080
SPRING_APPLICATION_NAME=codelab-backend
# Spring Boot: override application.properties via env
# e.g. SERVER_PORT, LOG_LEVEL, etc. Spring maps SERVER_PORT -> server.port

# Frontend build arg — URL the browser uses to reach backend.
# Inside docker-compose, nginx proxies /api -> backend:8080, so default /api works.
# For local dev without docker (Vite proxy), use http://localhost:8080
VITE_API_URL=/api

# Optional: pull-through / registry overrides
# COMPOSE_PROJECT_NAME=codelab
