# CodeLab Edu — environment configuration (VITE_ vars are PUBLIC, never put secrets here)

# Base URL of the execution backend.
# Default: Netlify Function proxy, aliased to /api/* by netlify.toml so the SPA
# fallback cannot shadow it (no secrets in the frontend).
VITE_EXEC_API_BASE=/api/execute

# Optional: direct Judge0-compatible API base URL (self-hosted instance, no key required).
# When set, the app calls it directly instead of the Netlify Function.
# Example: VITE_JUDGE0_URL=https://judge0.your-instance.example.com
# VITE_JUDGE0_URL=

# Netlify Function server-side secrets (configure in Netlify UI → Environment variables, NOT here):
#   JUDGE0_API_URL   e.g. https://judge0-ce.p.rapidapi.com  (or your self-hosted Judge0)
#   JUDGE0_API_KEY   API key for the provider (secret)
#   JUDGE0_API_HOST  Optional RapidAPI host header value
